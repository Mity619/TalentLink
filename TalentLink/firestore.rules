rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ==========================================
    // FUNCIONES DE AYUDA (Helpers)
    // ==========================================

    // Verifica si el usuario está autenticado
    function isSignedIn() {
      return request.auth != null;
    }

    // Verifica si el usuario autenticado es el dueño del documento
    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Obtiene el rol del usuario desde su documento en la colección 'users'
    // Nota: Usamos get() para leer el documento del usuario actual
    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.rol;
    }

    // Verifica si el usuario es administrador
    function isAdmin() {
      return isSignedIn() && getUserRole() == 'admin';
    }

    // Verifica si el usuario es reclutador o administrador
    function isRecruiterOrAdmin() {
      return isSignedIn() && (getUserRole() == 'recruiter' || getUserRole() == 'admin');
    }

    // Verifica si el usuario tiene una cuenta activa.
    function isActiveUser() {
    return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid))
        .data.activo == true;
    }

    // Verificar que sea un estudiante activo.
    function isActiveStudent() {
    return isActiveUser() &&
        getUserRole() == 'student';
    }

    // Verificar que una vacante exista y esté activa.
    function isJobAvailable(jobId) {
    return exists(
        /databases/$(database)/documents/jobs/$(jobId)
    ) &&
    get(
        /databases/$(database)/documents/jobs/$(jobId)
    ).data.estado == 'activa';
    }

    // Verificar que el reclutador sea propietario de la vacante.
    function isJobOwner(jobId) {
    return isActiveUser() &&
        getUserRole() == 'recruiter' &&
        exists(
        /databases/$(database)/documents/jobs/$(jobId)
        ) &&
        get(
        /databases/$(database)/documents/jobs/$(jobId)
        ).data.autorUid == request.auth.uid;
    }

    // Validar la estructura de una postulación.
    function isValidApplication(data) {
    return data.keys().hasAll([
        'jobId',
        'uid',
        'estado',
        'creadoEn'
    ]) &&
    data.keys().hasOnly([
        'jobId',
        'uid',
        'estado',
        'creadoEn'
    ]) &&
    data.jobId is string &&
    data.jobId.size() > 0 &&
    data.uid is string &&
    data.uid.size() > 0 &&
    data.estado in [
        'pendiente',
        'aceptada',
        'rechazada'
    ] &&
    data.creadoEn is timestamp;
    }

    // Validar la estructura de una vacante guardada.
    function isValidSavedJob(data) {
    return data.keys().hasAll([
        'uid',
        'jobId'
    ]) &&
    data.keys().hasOnly([
        'uid',
        'jobId'
    ]) &&
    data.uid is string &&
    data.uid.size() > 0 &&
    data.jobId is string &&
    data.jobId.matches('^[a-zA-Z0-9]+$');
    }

    // Verifica que las coordenadas sean válidas.
    function hasValidJobLocation(data) {
    return (
        data.lat is number &&
        data.lng is number &&
        data.lat >= -90 &&
        data.lat <= 90 &&
        data.lng >= -180 &&
        data.lng <= 180
    ) || (
        data.modalidad == 'remoto' &&
        data.lat == null &&
        data.lng == null
    );
    }

    // Verifica que los datos de una vacante sean válidos.
    function isValidJob(data) {
    return data.keys().hasAll([
        'titulo',
        'descripcion',
        'empresa',
        'area',
        'modalidad',
        'ciudad',
        'lat',
        'lng',
        'autorUid',
        'estado',
        'creadoEn'
    ]) &&
    data.keys().hasOnly([
        'titulo',
        'descripcion',
        'empresa',
        'area',
        'modalidad',
        'ciudad',
        'lat',
        'lng',
        'autorUid',
        'estado',
        'creadoEn'
    ]) &&
    data.titulo is string &&
    data.titulo.size() > 0 &&
    data.descripcion is string &&
    data.descripcion.size() > 0 &&
    data.empresa is string &&
    data.empresa.size() > 0 &&
    data.area in [
    'Tecnología',
    'Administración',
    'Ingeniería',
    'Finanzas',
    'Marketing y ventas',
    'Diseño',
    'Educación',
    'Salud',
    'Servicio al cliente',
    'Logística',
    'Otros'
    ] &&
    data.ciudad is string &&
    data.ciudad.size() > 0 &&
    data.modalidad in ['presencial', 'remoto', 'hibrido'] &&
    data.estado in ['activa', 'cerrada'] &&
    data.autorUid is string &&
    data.autorUid.size() > 0 &&
    data.creadoEn is timestamp &&
    hasValidJobLocation(data);
    }

    // Verifica que el usuario participe en el chat (lee el documento del chat).
    function isChatParticipant(chatId) {
      return isActiveUser() &&
        request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantes;
    }

    // ==========================================
    // COLECCIÓN: users/{uid}
    // ==========================================
    match /users/{uid} {
      // Un usuario puede leer su propio perfil, un admin puede leer todos
      allow read: if isSelf(uid) || isAdmin();

      // Al crear, solo el propio usuario puede crear su documento y el rol no puede ser 'admin'
      allow create: if isSelf(uid) && request.resource.data.rol in ['student', 'recruiter'];

      // Al actualizar: el dueño puede actualizar sus datos, pero NO puede cambiar su 'rol' ni 'activo'.
      // El admin puede actualizar cualquier campo (para bloquear/desbloquear o cambiar rol).
      allow update: if isAdmin() || (
        isSelf(uid) &&
        request.resource.data.rol == resource.data.rol &&
        request.resource.data.activo == resource.data.activo
      );

      // Solo un admin puede eliminar un perfil
      allow delete: if isAdmin();
    }

    // ==========================================
    // COLECCIÓN: jobs/{jobId}
    // ==========================================
    match /jobs/{jobId} {

    // Solo usuarios autenticados y activos pueden consultar vacantes.
    allow read: if isActiveUser();

    // Solo reclutadores y administradores activos pueden publicar.
    allow create: if isActiveUser() &&
        isRecruiterOrAdmin() &&
        request.resource.data.autorUid == request.auth.uid &&
        request.resource.data.estado == 'activa' &&
        request.resource.data.creadoEn == request.time &&
        isValidJob(request.resource.data);

    // Solo el reclutador propietario o un administrador
    // pueden modificar una vacante.
    allow update: if isActiveUser() &&
        isRecruiterOrAdmin() &&
        (
        resource.data.autorUid == request.auth.uid ||
        isAdmin()
        ) &&
        request.resource.data.autorUid == resource.data.autorUid &&
        request.resource.data.creadoEn == resource.data.creadoEn &&
        isValidJob(request.resource.data);

    // Solo el reclutador propietario o un administrador
    // pueden eliminar una vacante.
    allow delete: if isActiveUser() &&
        isRecruiterOrAdmin() &&
        (
        resource.data.autorUid == request.auth.uid ||
        isAdmin()
        );
    }

    // ==========================================
    // COLECCIÓN: applications/{applicationId}
    // ==========================================
    match /applications/{applicationId} {

    // Consultar una postulación individual.
    allow get: if isActiveUser() && (
        isAdmin() ||
        (
        resource != null &&
        (
            resource.data.uid == request.auth.uid ||
            isJobOwner(resource.data.jobId)
        )
        ) ||
        (
        resource == null &&
        isActiveStudent() &&
        applicationId.matches(
            '^[a-zA-Z0-9]+_' + request.auth.uid + '$'
        )
        )
    );

    // Consultar un listado de postulaciones.
    allow list: if isActiveUser() && (
        isAdmin() ||
        resource.data.uid == request.auth.uid ||
        isJobOwner(resource.data.jobId)
    );

    // Crear una postulación.
    allow create: if isActiveStudent() &&
        isValidApplication(request.resource.data) &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.jobId.matches('^[a-zA-Z0-9]+$') &&
        applicationId ==
        request.resource.data.jobId + '_' + request.auth.uid &&
        request.resource.data.estado == 'pendiente' &&
        request.resource.data.creadoEn == request.time &&
        isJobAvailable(request.resource.data.jobId);

    // Actualizar únicamente el estado de una postulación.
    allow update: if isActiveUser() &&
        (
        isAdmin() ||
        isJobOwner(resource.data.jobId)
        ) &&
        isValidApplication(request.resource.data) &&
        request.resource.data.diff(resource.data)
        .affectedKeys().hasOnly(['estado']);

    // Únicamente los administradores pueden eliminar.
    allow delete: if isActiveUser() &&
        isAdmin();
    }

    // ==========================================
    // COLECCIÓN: savedJobs/{savedJobId}
    // ==========================================
    match /savedJobs/{savedJobId} {

    // Consultar los favoritos propios.
    allow read: if isActiveStudent() &&
        resource.data.uid == request.auth.uid;

    // Guardar una vacante.
    allow create: if isActiveStudent() &&
        isValidSavedJob(request.resource.data) &&
        request.resource.data.uid == request.auth.uid &&
        savedJobId ==
        request.auth.uid + '_' +
        request.resource.data.jobId &&
        isJobAvailable(request.resource.data.jobId);

    // Permitir escrituras repetidas sin modificar datos.
    allow update: if isActiveStudent() &&
        resource.data.uid == request.auth.uid &&
        isValidSavedJob(request.resource.data) &&
        savedJobId ==
        request.auth.uid + '_' +
        request.resource.data.jobId &&
        request.resource.data == resource.data;

    // Quitar una vacante guardada propia.
    allow delete: if isActiveStudent() && (
    (
        resource != null &&
        resource.data.uid == request.auth.uid
    ) ||
    (
        resource == null &&
        savedJobId.matches(
        '^' + request.auth.uid + '_[a-zA-Z0-9]+$'
        )
    )
    );
    }

    // ==========================================
    // COLECCIÓN: cvs/{uid}
    // ==========================================
    match /cvs/{uid} {
      // El dueño puede leer y escribir su CV. Un admin puede leerlos todos.
      allow read: if isSelf(uid) || isAdmin();
      allow write: if isSelf(uid);
    }

    // ==========================================
    // COLECCIÓN: chats/{chatId}
    // ==========================================
    match /chats/{chatId} {
      // resource == null: permite comprobar si el chat existe antes de crearlo.
      allow read: if isActiveUser() && (
        resource == null ||
        request.auth.uid in resource.data.participantes
      );

      // ID = uids ordenados unidos por '_', así hay un solo chat por pareja.
      allow create: if isActiveUser() &&
        request.resource.data.participantes.size() == 2 &&
        request.auth.uid in request.resource.data.participantes &&
        chatId == request.resource.data.participantes[0] + '_' + request.resource.data.participantes[1];

      allow update: if isActiveUser() &&
        request.auth.uid in resource.data.participantes &&
        request.resource.data.participantes == resource.data.participantes;

      // ==========================================
      // SUBCOLECCIÓN: chats/{chatId}/messages/{messageId}
      // ==========================================
      match /messages/{messageId} {
        allow read: if isChatParticipant(chatId);

        allow create: if isChatParticipant(chatId) &&
          request.resource.data.autorUid == request.auth.uid &&
          request.resource.data.texto is string &&
          request.resource.data.texto.size() > 0 &&
          request.resource.data.texto.size() <= 1000;
      }
    }

    // ==========================================
    // COLECCIÓN: reports/{reportId}
    // ==========================================
    match /reports/{reportId} {
      // Cualquier usuario autenticado puede crear un reporte
      allow create: if isSignedIn();
      // Solo un admin puede leer y gestionar los reportes
      allow read, update, delete: if isAdmin();
    }
  }
}
